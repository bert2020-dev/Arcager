+
+
+def _importable(module: str) -> bool:
+    try:
+        r = subprocess.run([sys.executable, "-c", f"import {module}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
+        return r.returncode == 0
+    except Exception:
+        return False
+
+
+def install_dependencies() -> int:
+    """--install-deps: pip-install whatever Arcager needs that this Python is missing."""
+    missing = [(m, pkg, why) for m, pkg, why in _PYTHON_COMPONENTS if not _importable(m)]
+    if not missing:
+        print("Everything Arcager needs is already installed. (arcager -V shows the details.)")
+        return 0
+    names = [pkg for _, pkg, _ in missing]
+    print(f"Installing {', '.join(names)} into {sys.executable} …")
+    for _, pkg, why in missing:
+        print(f"  {pkg}: for {why}")
+    try:
+        r = subprocess.run([sys.executable, "-m", "pip", "install", *names], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    except OSError as exc:
+        err(f"could not run pip with {sys.executable}: {exc}")
+        return 1
+    output = r.stdout or ""
+    if r.returncode != 0:
+        tail = "\n".join(output.strip().splitlines()[-6:])
+        err("pip could not install the packages.\n" + tail)
+        exe = sys.executable
+        if "externally-managed-environment" in output:
+            print("\nThis Python belongs to your operating system, so pip refuses to change it. Use a virtual environment instead:\n"
+                  "  python3 -m venv .venv\n"
+                  "  .venv/bin/python -m pip install -r requirements.txt        (Windows: .venv\\Scripts\\python -m pip install -r requirements.txt)\n"
+                  "then run Arcager with that Python:  .venv/bin/python arcager.py ...", file=sys.stderr)
+        elif "No module named pip" in output:
+            print(f"\npip is not installed for this Python. Run:  {exe} -m ensurepip --upgrade   and try again.", file=sys.stderr)
+        elif re.search(r"(?i)connection|network|resolution|timed out|Could not find a version|No matching distribution", output):
+            print("\npip could not reach the package index. Check your internet connection (or proxy settings) and try again.", file=sys.stderr)
+        else:
+            print(f"\nTry the same command by hand to see the full output:  {exe} -m pip install {' '.join(names)}", file=sys.stderr)
+        return 1
+    still = [pkg for m, pkg, _ in missing if not _importable(m)]
+    if still:
+        err(f"pip finished, but this Python still cannot import: {', '.join(still)}. Run arcager -V to see the interpreter in use.")
+        return 1
+    print(f"Done. Installed: {', '.join(names)}.")
+    return 0
+
